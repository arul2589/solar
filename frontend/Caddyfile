# Behind another proxy (Traefik) on a private network: keep the visitor's real IP (X-Forwarded-For)
# so rate limits and login lockouts are per visitor. Public clients cannot spoof it.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# SITE_ADDRESS=":80" for local HTTP; set it to "solar.example.com" in production and Caddy
# obtains and renews HTTPS certificates automatically (HTTP is redirected to HTTPS).
{$SITE_ADDRESS::80} {
	encode gzip
	request_body /api/* {
		max_size 60MB
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# only our own scripts may run; blocks injected scripts even if a bug lets HTML through
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		# browsers only honour this over HTTPS (production); harmless on local HTTP
		Strict-Transport-Security "max-age=31536000"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}
